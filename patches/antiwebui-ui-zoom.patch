 }
 
 wayland_client::delegate_noop!(State: ignore zwlr_layer_shell_v1::ZwlrLayerShellV1);
+
+/// UI zoom (`ANTIWEBUI_UI_ZOOM`, e.g. 0.85): the UI is laid out and drawn at this factor of its
+/// normal size. Sizes the UI asks of the compositor are multiplied by it; the scale the UI renders
+/// with is multiplied too (see `State::ui_scale`).
+pub fn ui_zoom() -> f64 {
+    static Z: std::sync::OnceLock<f64> = std::sync::OnceLock::new();
+    *Z.get_or_init(|| {
+        std::env::var("ANTIWEBUI_UI_ZOOM")
+            .ok()
+            .and_then(|v| v.parse::<f64>().ok())
+            .filter(|z| (0.3..=3.0).contains(z))
+            .unwrap_or(1.0)
+    })
+}
+
+pub(crate) fn zoomed(n: i32) -> i32 {
+    (n as f64 * ui_zoom()).round() as i32
+}
